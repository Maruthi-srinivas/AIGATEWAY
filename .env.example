# Copy to .env if you want to override Compose defaults.
# Do not commit .env. All services still run only inside Docker.

POSTGRES_USER=aigateway
POSTGRES_PASSWORD=aigateway
POSTGRES_DB=aigateway
POSTGRES_DSN=postgresql://aigateway:aigateway@postgres:5432/aigateway
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

# Local-only secrets. Change before any non-local deploy.
JWT_SECRET=dev-insecure-jwt-secret-change-me
INTERNAL_AUTH_TOKEN=dev-internal-token-change-me
SEED_PASSWORD=changeme
SEED_HR_API_KEY=agt_demo_hr_local_docker_only_key
SEED_ENG_API_KEY=agt_demo_eng_local_docker_only_key
RATE_LIMIT_TENANT_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=20
RATE_LIMIT_API_KEY_PER_MINUTE=60
STUB_STREAM_DELAY_MS=20
CHAT_BODY_MAX_BYTES=32768
CHAT_MESSAGE_MAX_CHARS=8000

# Guardrails. Vendor key stays on the guardrails container only.
GUARDRAILS_MODE=fixture
GUARDRAILS_API_URL=https://commentanalyzer.googleapis.com/v1alpha1/comments:analyze
GUARDRAILS_API_KEY=
GUARDRAILS_MODERATION_THRESHOLD=0.7
GUARDRAILS_TIMEOUT_SECONDS=2

# TypeSafe Jev. Key stays on the guardrails container only. Empty uses fixture.
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=0.8

# RAG. Embedding key stays on the rag container only. Empty uses hashed fixtures.
EMBEDDING_MODE=fixture
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RAG_MIN_SCORE=0.3
RAG_TOP_K=8
RAG_TIMEOUT_SECONDS=2

# LLM. Key stays on the gateway. Empty uses the grounded fixture.
LLM_MODE=fixture
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
