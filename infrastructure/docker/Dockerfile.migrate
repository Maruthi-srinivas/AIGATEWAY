FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.6.17 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid app --create-home --shell /usr/sbin/nologin app

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY apps ./apps
COPY services ./services

RUN uv sync --frozen --no-dev --all-packages \
    && chown -R app:app /app

USER app

CMD ["sh", "-c", "alembic -c services/auth/alembic.ini upgrade head && alembic -c apps/gateway/alembic.ini upgrade head && alembic -c services/guardrails/alembic.ini upgrade head && alembic -c services/rag/alembic.ini upgrade head"]
