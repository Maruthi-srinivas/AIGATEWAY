FROM node:22-alpine AS build

WORKDIR /src

COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

COPY apps/web/ ./

ARG VITE_GATEWAY_ORIGIN=http://localhost:8000
ENV VITE_GATEWAY_ORIGIN=$VITE_GATEWAY_ORIGIN

RUN npm test && npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY infrastructure/docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=nginx:nginx /src/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
