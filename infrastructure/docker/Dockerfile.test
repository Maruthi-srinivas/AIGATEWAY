FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.6.17 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY apps ./apps
COPY services ./services
COPY tests ./tests
COPY infrastructure/docker/healthcheck.py ./infrastructure/docker/healthcheck.py

RUN uv sync --frozen --all-packages --group dev

CMD ["sh", "-c", "ruff check apps services packages tests infrastructure/docker/healthcheck.py && ruff format --check apps services packages tests infrastructure/docker/healthcheck.py && pytest -q"]
